// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ──────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  USER

  @@map("user_role")
}

// ── Auth Models (Better Auth Compatible) ──────────────────────────────────

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // SMART-SDLP Custom Fields
  role      UserRole @default(USER)
  nip       String?  @unique
  jabatan   String?
  unitKerja String?
  isActive  Boolean  @default(true)
  mustChangePassword Boolean @default(false)

  sessions          Session[]
  accounts          Account[]
  kegiatanSebagaiPJ Kegiatan[] @relation("KegiatanPJ")
  laporanSubmitted  Laporan[]  @relation("LaporanSubmitter")
  dokumenUploaded   Dokumen[]  @relation("DokumenUploader")
  laporans          Laporan[]
   notifications     Notification[]
  reportAccessCreated ReportAccessOverride[] @relation("ReportAccessCreatedBy")
  accessRequested     ReportAccessRequest[]  @relation("AccessRequestRequester")
  accessDecided       ReportAccessRequest[]  @relation("AccessRequestDecider")

  @@map("user")
}

model AuthAttempt {
  id          String   @id @default(cuid())
  identifier  String
  kind        String
  attemptedAt DateTime @default(now())

  @@index([identifier, kind, attemptedAt])
  @@map("auth_attempt")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  issuer String

  @@unique([issuer, accountId], map: "account_issuer_accountId_uidx")
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum JenisAnggaran {
  APBN
  NON_APBN
}

enum StatusAnggaran {
  DIBUKA
  DIBLOKIR

  @@map("status_anggaran")
}

model AppSettings {
  id                String   @id @default(cuid())
  reportDeadlineDay Int      @default(25)
  reportDeadlineTime String  @default("23:59")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("app_settings")
}

model ProgramCategory {
  id        String     @id @default(cuid())
  name      String     @unique
  sortOrder Int
  colorKey  String
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  kegiatan  Kegiatan[]

  @@map("program_category")
}

model Kegiatan {
  id              String         @id @default(cuid())
  kode            String         @unique
  nama            String
  jenis           JenisAnggaran?
  programCategory   String?
  programCategoryId String?
  programCategoryRef ProgramCategory? @relation(fields: [programCategoryId], references: [id], onDelete: Restrict)
  pagu            BigInt
  realisasi       BigInt         @default(0)
  fisik           Int?           @default(0)
  uraian          String?
  statusAnggaran  StatusAnggaran @default(DIBUKA)
  realLalu        BigInt?        @default(0)
  realIni         BigInt?        @default(0)
  wajib           Boolean        @default(false)
  sudahLapor      Boolean        @default(false)

  pjId String?
  pj   User?   @relation("KegiatanPJ", fields: [pjId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  laporan   Laporan[]
  dokumen   Dokumen[]
  accessOverrides ReportAccessOverride[]
  accessRequests  ReportAccessRequest[]

  @@index([pjId])
  @@index([kode])
  @@map("kegiatan")
}

model Laporan {
  id         String   @id @default(cuid())
  kegiatanId String
  kegiatan   Kegiatan @relation(fields: [kegiatanId], references: [id], onDelete: Cascade)

  periodeBulan Int
  periodeTahun Int

  uraian         String
  fisik          Float
  statusAnggaran StatusAnggaran @default(DIBUKA)

  realLalu  BigInt
  realIni   BigInt
  realisasi BigInt

  submittedById String?
  submittedBy   User?   @relation("LaporanSubmitter", fields: [submittedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?

  @@unique([kegiatanId, periodeBulan, periodeTahun])
  @@index([kegiatanId])
  @@map("laporan")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  href      String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt, createdAt])
  @@map("notification")
}

model AuditLog {
  id           String   @id @default(cuid())
  action       String   @default("DELETE_LAPORAN")
  namaFile     String
  kodeKegiatan String
  namaKegiatan String
  pemilikNama  String
  pemilikEmail String
  adminNama    String
  adminEmail   String
  alasan       String
  notifStatus  String   @default("Terkirim ke Email")
  createdAt    DateTime @default(now())

  @@map("audit_log")
}

enum KategoriDokumen {
  SK
  DIPA
  KONTRAK
  LAPORAN
  ESURAT
  LAINNYA

  @@map("kategori_dokumen")
}

model Dokumen {
  id       String          @id @default(cuid())
  nama     String
  kategori KategoriDokumen @default(SK)
  fileUrl  String?
  fileType String?         @default("pdf")
  ukuran   String?         @default("1.2 MB")
  tanggal  DateTime        @default(now())

  kegiatanId String?
  kegiatan   Kegiatan? @relation(fields: [kegiatanId], references: [id], onDelete: SetNull)

  uploaderId String?
  uploader   User?   @relation("DokumenUploader", fields: [uploaderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kegiatanId])
  @@index([uploaderId])
  @@map("dokumen")
}

model ReportAccessOverride {
  id           String    @id @default(cuid())
  kegiatanId   String
  kegiatan     Kegiatan  @relation(fields: [kegiatanId], references: [id], onDelete: Cascade)
  periodeBulan Int
  periodeTahun Int
  openedUntil  DateTime
  reason       String
  createdById  String?
  createdBy    User?     @relation("ReportAccessCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  @@unique([kegiatanId, periodeBulan, periodeTahun], map: "report_access_override_kegiatan_periode_key")
  @@index([kegiatanId])
  @@map("report_access_override")
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("access_request_status")
}

model ReportAccessRequest {
  id            String              @id @default(cuid())
  kegiatanId    String
  kegiatan      Kegiatan            @relation(fields: [kegiatanId], references: [id], onDelete: Cascade)
  periodeBulan  Int
  periodeTahun  Int
  reason        String
  status        AccessRequestStatus @default(PENDING)
  requestedById String
  requestedBy   User                @relation("AccessRequestRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  decidedById   String?
  decidedBy     User?               @relation("AccessRequestDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime            @default(now())

  @@index([status])
  @@index([kegiatanId, periodeBulan, periodeTahun], map: "report_access_request_periode_idx")
  @@map("report_access_request")
}
